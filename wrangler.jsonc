{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "profile-images",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "profile-images-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "profile-images-files"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "SITE_CLOSED": "true"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
