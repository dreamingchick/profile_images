{
  "name": "profile-images",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply profile-images-db --local",
    "db:remote": "wrangler d1 migrations apply profile-images-db --remote",
    "check": "node --check src/index.js && node --check public/app.js && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}